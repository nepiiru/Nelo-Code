{
  "name": "nelo-code",
  "version": "0.1.0",
  "description": "Nelo Code — an AI coding agent for your terminal.",
  "type": "module",
  "bin": {
    "nelo": "bin/nelo.js"
  },
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node bin/nelo.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "mock": "node scripts/mock-server.mjs"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "claude",
    "anthropic",
    "terminal"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
