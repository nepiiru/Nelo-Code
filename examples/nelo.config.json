{
  "provider": "ollama",
  "model": "qwen2.5-coder:7b",
  "maxTokens": 4096,
  "maxTurns": 40,
  "permissions": {
    "mode": "ask",
    "allow": [],
    "denyCommands": ["\\bcurl\\b", "\\bwget\\b"]
  },
  "context": {
    "maxTokens": 32768,
    "compactAt": 0.7
  },
  "workspace": {
    "allowOutside": false
  },
  "sampling": {
    "temperature": 0.2,
    "topP": 0.9
  },
  "request": {
    "timeoutMs": 300000
  },
  "ui": {
    "theme": "nelo",
    "resources": true,
    "resourceIntervalMs": 1000
  }
}
